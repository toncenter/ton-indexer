[Unit]
Description=firecore merger: one-block files of the reader-node into merged-blocks bundles
After=network-online.target garage.service
Wants=network-online.target

[Service]
User=firecore
Group=firecore
EnvironmentFile=/etc/firecore/garage.env
WorkingDirectory=/srv/scratch/firecore
ExecStart=/usr/local/bin/firecore start merger --config-file= \
  --data-dir=/srv/scratch/firecore/merger --log-to-file=false \
  --common-first-streamable-block=1 \
  "--common-one-block-store-url=s3://localhost:3900/firehose/one-blocks?region=garage&insecure=true" \
  "--common-merged-blocks-store-url=s3://localhost:3900/firehose/merged-blocks?region=garage&insecure=true" \
  "--common-forked-blocks-store-url=s3://localhost:3900/firehose/forked-blocks?region=garage&insecure=true" \
  --merger-grpc-listen-addr=127.0.0.1:10012 --merger-http-healthz-addr=127.0.0.1:10013 \
  --metrics-listen-addr=127.0.0.1:9103 --pprof-listen-addr=127.0.0.1:6061 --log-level-switcher-listen-addr=127.0.0.1:1066
Restart=always
RestartSec=5
LimitNOFILE=1048576
MemoryMax=16G

[Install]
WantedBy=multi-user.target
