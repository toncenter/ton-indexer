[Unit]
Description=Gramstat read-only chart API
Wants=network-online.target
After=network-online.target

[Service]
User=gramstat-api
Group=gramstat-api
EnvironmentFile=/etc/gramstat-api.env
ExecStart=/opt/gramstat/bin/gramstat-api --listen 127.0.0.1:2008
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
