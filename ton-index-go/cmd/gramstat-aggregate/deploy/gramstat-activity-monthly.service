[Unit]
Description=Gramstat calendar-month unique Activity
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gramstat
Group=gramstat
EnvironmentFile=/etc/gramstat-activity-history.env
StateDirectory=gramstat-aggregate
ExecStart=/usr/bin/flock --nonblock /var/lib/gramstat-aggregate/activity-monthly.lock /opt/gramstat/bin/gramstat-aggregate-monthly --handlers actions_monthly --actions-statement-timeout 50m --timeout 55m
TimeoutStartSec=60min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
MemoryMax=1G
